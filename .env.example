NODE_ENV=development
PORT=4000

# Origin of the ssMarket frontend. Used for redirects and the OAuth callback URL.
WEB_URL=http://localhost:3000

DATABASE_URL=postgres://ssmarket:ssmarket@localhost:5433/ssmarket
REDIS_URL=redis://localhost:6380

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-your-client-secret

# Only Google Workspace accounts on this domain may sign in.
ALLOWED_EMAIL_DOMAIN=example.com

# Any random string of at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# Uploaded images are stored on local disk in this directory.
UPLOAD_DIR=./uploads

# Local testing only: enables GET /auth/dev-login?as=<name>, which signs in as a
# made-up person without Google. Works only when NODE_ENV=development, and the
# app refuses to start if this is true in production.
DEV_LOGIN_ENABLED=false
